# Sample Caddyfile for the Epimethean Challenge documentation site.
#
# The docs are a static Hugo build served under the /docs path of
# epimethean.dev (matching the Hugo `baseURL` of https://epimethean.dev/docs).
# Caddy provisions and renews TLS for epimethean.dev automatically.
#
# Deploy: build with `hugo` and copy the CONTENTS of the generated `public/`
# directory to /srv/epimethean/docs on the server. `handle_path /docs/*` strips
# the /docs prefix, so /docs/tutorial/ is served from
# /srv/epimethean/docs/tutorial/.
#
# This is a template — adjust the site address and root path for your
# environment. Other routes (e.g. the pyre app) can live alongside the docs
# block in the same site.

epimethean.dev {
	# Documentation site (static Hugo output), served under /docs.
	handle_path /docs/* {
		root * /srv/epimethean/docs
		file_server

		# Long-cache Hugo's fingerprinted assets.
		@assets path *.css *.js *.woff *.woff2 *.png *.jpg *.jpeg *.svg *.ico *.webp
		header @assets Cache-Control "public, max-age=2592000, immutable"
	}

	# Send bare /docs to /docs/ so relative asset paths resolve.
	redir /docs /docs/ 301

	# Serve Hugo's generated 404 page for missing pages.
	handle_errors {
		@404 expression {http.error.status_code} == 404
		handle @404 {
			root * /srv/epimethean/docs
			rewrite * /404.html
			file_server
		}
	}
}
